PORT=4000
DATABASE_URL="file:./dev.db"
JWT_SECRET=replace-with-long-secret

# SMS Provider Configuration for OTP
# Options: "msg91" | "twilio" | "custom"
SMS_PROVIDER=msg91

# MSG91 Configuration (Recommended for India)
# Get API Key from: https://msg91.com/dashboard/api
MSG91_API_KEY=YOUR_MSG91_API_KEY_HERE
MSG91_SENDER_ID=VADHYR
MSG91_ROUTE=4

# Alternative: Twilio Configuration (for global testing)
# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# Alternative: Custom Webhook Configuration
# SMS_WEBHOOK_URL=https://your-sms-api.com/send
# SMS_WEBHOOK_API_KEY=optional_api_key
