{
  "typescript.tsserver.excludeDirectories": ["**/.history"],
  "javascript.suggestionActions.enabled": false,
  "json.schemaDownload.enable": false,
  "json.schemas": [
    {
      "fileMatch": ["/tsconfig.json", "/tsconfig.*.json"],
      "schema": {
        "type": "object",
        "additionalProperties": true
      }
    }
  ]
  "json.schemas": [
    {
      "fileMatch": [
        "**/tsconfig.json",
        "**/tsconfig.*.json"
      ],
      "url": "./.vscode/tsconfig.schema.json"
    }
  ]
}
